# ==============================================================================
# SIH-26143 Maritime Oil Spill Surveillance - Environment Configuration Template
# Copy this file to .env and fill in your private API credentials if needed.
# NEVER COMMIT YOUR REAL .env FILE TO GIT!
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=False

# Copernicus Climate Data Store (CDS API - ERA5 Wind Reanalysis)
# Register at: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-api-key-here

# Copernicus Marine Service (CMEMS - Hourly Ocean Surface Currents)
# Register at: https://marine.copernicus.eu/
COPERNICUSMARINE_SERVICE_USERNAME=your-cmems-username
COPERNICUSMARINE_SERVICE_PASSWORD=your-cmems-password

# Optional: External AIS Feed Provider (e.g., Spire Maritime / AISHub / MarineTraffic)
AIS_STREAM_API_KEY=your-ais-api-key-here

